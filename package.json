{
  "name": "tterm",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "wdio run e2e/wdio.conf.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e:ime": "wdio run e2e/wdio.conf.js --spec e2e/specs/ime.e2e.js",
    "test:e2e:anime": "wdio run e2e/wdio.conf.js --spec e2e/specs/anime.e2e.js",
    "test:e2e:share": "wdio run e2e/wdio.conf.js --spec e2e/specs/share.e2e.js",
    "test:e2e:release": "wdio run e2e/wdio.release.conf.js"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "^5.2.3",
    "@fontsource/fira-mono": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/ubuntu-mono": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.14.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tauri-apps/cli": "^2",
    "@types/sortablejs": "^1.15.9",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "happy-dom": "^20.11.0",
    "sharp": "^0.34.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.0"
  }
}
