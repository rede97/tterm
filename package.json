{
  "name": "tterm",
  "private": true,
  "version": "3.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "wdio run e2e/wdio.conf.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e:ime": "wdio run e2e/wdio.conf.js --spec e2e/specs/ime.e2e.js",
    "test:e2e:anime": "wdio run e2e/wdio.conf.js --spec e2e/specs/anime.e2e.js",
    "test:e2e:share": "wdio run e2e/wdio.conf.js --spec e2e/specs/share.e2e.js",
    "test:e2e:release": "wdio run e2e/wdio.release.conf.js",
    "demo:hero": "bun drafts/demo/hero.mjs",
    "demo:agent": "bun drafts/demo/agent.mjs",
    "demo:share": "bun drafts/demo/share.mjs"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/cascadia-mono": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-search": "0.17.0-beta.310",
    "@xterm/addon-web-links": "0.13.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/xterm": "6.1.0-beta.315",
    "lit-html": "^3.3.3",
    "lucide": "^1.61.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/sortablejs": "^1.15.9",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "happy-dom": "^20.14.6",
    "sharp": "^0.34.5",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "webdriverio": "^9.32.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
